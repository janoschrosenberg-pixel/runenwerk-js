# keymap.config - Tastenbelegung von RUNENWERK JS
#
# Rechts steht ein Befehl wie im Terminal (:): eine Funktion des Editors oder eine
# Mapping-Funktion aus /mapping, mit Argumenten ohne Klammern und Anfuehrungszeichen.
# Tasten: Zeichen, Folgen (dd), ESC ENTER TAB Shift-TAB BACKSPACE DELETE INSERT UP DOWN LEFT RIGHT
# HOME END PGUP PGDN SPACE F1..F12 Ctrl-a..Ctrl-z Ctrl-SPACE Ctrl-+ Ctrl-- Alt-ENTER;
# ANY = jede andere druckbare Taste (Zeichen als Argument).
# Auf dem Mac gilt Cmd wie Ctrl. "# = ..." belegt die Taste # (sonst ist # ein Kommentar).

# Tastaturlayouts des Editors, unabhaengig vom Layout des Betriebssystems; Strg+G (Mac: Cmd+G) schaltet
# weiter, das erste gilt beim Start. Die Statuszeile zeigt das aktive farbig neben dem Mode.
#   en_US  US-Belegung
#   de_DE  deutsche Belegung (AltGr bzw. Option fuer [ ] { } | \ @ ~)
#   prog   nur Ziffern und Sonderzeichen auf den Buchstaben, alle anderen Tasten wie en_US:
#          Q W E R T    [{ 7& 8* 9( ]}      Y U I O P    !? (< )> "' &#
#          A S D F G    ;: 4$ 5% 6^ =+      H J K L      -_ 0. +* /\
#          Z X C V B    `~ 1! 2@ 3# \|      N M          $% |~
#          (links ein Ziffernblock, Shift wie auf der US-Zahlenreihe)
# set system: Layout des Betriebssystems (auto = Eingabequelle des Systems, sonst de_DE oder en_US)
set layouts en_US de_DE prog
set system auto
set start normal

# eigenes Layout: Zeichen ersetzen (mit in die Liste: set layouts en_US custom ...)
layout custom extends de_DE {
  z = y
  y = z
}

mode base {
  # Speicherbaenke: Strg+C Ziffer kopiert, Strg+V Ziffer fuegt ein, Ziffer auch mit Strg;
  # Strg+C b VON NACH kopiert eine Bank in eine andere
  # 1 = Systemzwischenablage (dd/x/yy ueberschreiben sie nicht), 0 = zuletzt Geloeschtes/Kopiertes, 2-9 eigene
  Ctrl-c DIGIT = bankCopy
  Ctrl-c Ctrl-DIGIT = bankCopy
  Ctrl-c b DIGIT DIGIT = bankTransfer
  Ctrl-v DIGIT = bankPaste
  Ctrl-v Ctrl-DIGIT = bankPaste
  F9 = compile
  F10 = compileFast
  F11 = fullscreen
  Ctrl-s = save
  Ctrl-p = fileManager search
  Ctrl-q = quit
  Ctrl-+ = fontBigger
  Ctrl-- = fontSmaller
  UP = cursorUp
  DOWN = cursorDown
  LEFT = cursorLeft
  RIGHT = cursorRight
  HOME = lineStart
  END = lineEnd
  PGUP = pageUp
  PGDN = pageDown
}

# Bewegungen und Zaehler: gelten in normal, visual und operator (d, c, y, ... warten auf eine Bewegung)
mode motions extends base {
  1 = count 1
  2 = count 2
  3 = count 3
  4 = count 4
  5 = count 5
  6 = count 6
  7 = count 7
  8 = count 8
  9 = count 9
  0 = countZero
  ESC = cancel
  h = motion h
  j = motion j
  k = motion k
  l = motion l
  LEFT = motion h
  DOWN = motion j
  UP = motion k
  RIGHT = motion l
  BACKSPACE = motion h
  HOME = motion 0
  END = motion $
  w = motion w
  W = motion W
  b = motion b
  B = motion B
  e = motion e
  E = motion E
  ge = motion ge
  gE = motion gE
  ^ = motion ^
  $ = motion $
  _ = motion _
  + = motion +
  - = motion -
  gg = motion gg
  G = motion G
  H = motion H
  M = motion M
  L = motion L
  f = awaitChar motion f
  t = awaitChar motion t
  F = awaitChar motion F
  T = awaitChar motion T
  ; = motion ;
  , = motion ,
  % = motion %
  { = motion {
  } = motion }
  n = motion n
  N = motion N
  ' = awaitChar gotoMarkLine
  ` = awaitChar gotoMark
  " = awaitChar selectRegister
  Ctrl-d = scroll halfDown
  Ctrl-u = scroll halfUp
  Ctrl-f = scroll pageDown
  Ctrl-b = scroll pageUp
  PGDN = scroll pageDown
  PGUP = scroll pageUp
  Ctrl-e = scroll lineDown
  Ctrl-y = scroll lineUp
  Ctrl-l = scroll lineRight
  Ctrl-h = scroll lineLeft
  zz = scroll center
  zt = scroll top
  zb = scroll bottom
}

mode normal extends motions {
  ENTER = motion ENTER
  i = switchState insert
  a = appendAfter
  A = appendLineEnd
  I = insertLineStart
  o = openLineBelow
  O = openLineAbove
  # Operatoren: danach eine Bewegung oder ein Textobjekt (dw, ciw, yap, >}, gUiw, dd ...)
  d = operator d
  c = operator c
  y = operator y
  > = operator >
  < = operator <
  gu = operator gu
  gU = operator gU
  g~ = operator g~
  x = opMotion d l
  DELETE = opMotion d l
  X = opMotion d h
  s = opMotion c l
  S = opLine c
  C = opMotion c $
  D = opMotion d $
  Y = opLine y
  p = paste
  P = pasteBefore
  u = undo
  Ctrl-r = redo
  Ctrl-z = undo
  . = dot
  r = awaitChar replaceChar
  R = switchState replace
  ~ = toggleCase
  J = join
  gJ = joinNoSpace
  Ctrl-a = increment
  Ctrl-x = decrement
  v = visual v
  V = visual V
  Ctrl-v = visual b
  Ctrl-V = visual b
  gv = reselect
  q = macroQ
  @ = awaitChar macroPlay
  m = awaitChar setMark
  : = console
  / = find
  ? = findBack
  * = findWord
  # = findWordBack
  gt = nextTab
  gT = prevTab
  ZZ = wq
  ZQ = q!
  # Language Server
  gd = gotoDefinition
  F12 = gotoDefinition
  # zur Implementierung (Interface/abstrakte Methode), bei mehreren Auswahlliste
  gi = gotoImplementation
  Ctrl-F12 = gotoImplementation
  gr = references
  Ctrl-o = goBack
  K = hover
  # von Methode zu Methode (TypeScript und Java, ueber den Language Server)
  ]m = methodNext
  [m = methodPrev
  Ctrl-j = methodNext
  Ctrl-k = methodPrev
  # Git (Repo der aktuellen Datei). SPACE g zeigt das Menue in der Statuszeile, es bleibt offen bis zu einem
  # Befehl oder ESC; BACKSPACE geht eine Ebene hoeher. Eigene Menues: menu TASTEN = Titel { TASTE = BEFEHL # Text }
  SPACE b = gitBranch
  menu SPACE g = Git {
    s = gitStatus            # Status
    c = gitCommit            # Commit
    p = gitPull              # Pull
    P = gitPush              # Push
    d = gitDiff              # Diff mit Commit
    D = gitDiff HEAD         # Diff mit HEAD
    m = gitMerge             # Merge-Editor
    M = gitMergeBranch       # Branch mergen
    B = gitBlame             # Blame
    R = gitReset             # Reset --hard
    menu b = Branch {
      b = gitBranch          # wechseln
      t = gitBranch ts       # im TypeScript-Repo
      j = gitBranch java     # im Java-Repo
    }
    menu r = Pull Requests {
      r = scmPullRequests    # Liste
      n = scmCreate          # erstellen
    }
  }
  # Terminal als eigener Tab (beliebig viele)
  SPACE t = terminal
  # SQL-Dateien: Statement am Cursor, ganze Datei, Konto wechseln, Ergebnis, Commit/Rollback/Abbruch
  Ctrl-ENTER = sqlRun
  F5 = sqlRunFile
  F6 = sqlAccount
  SPACE o = resultFocus
  F4 = resultFocus
  SPACE O = resultClose
  SPACE s m = sqlMetaRefresh
  SPACE s c = sqlCommit
  SPACE s r = sqlRollback
  SPACE s x = sqlCancel
  SPACE s s = sqlRun
  # neue, leere SQL-Datei fuer schnelle Abfragen
  SPACE q = sqlScratch
  # Spring Boot (Profil aus spring.profile, Vorgabe dev): starten, Profil waehlen, mit Debugger, stoppen
  SPACE a a = springRun
  SPACE a p = springProfile
  SPACE a d = springDebug
  SPACE a b = springBuild
  SPACE a g = openapiGenerate
  SPACE a x = springStop
  # Debugger (Java und JS/TS gleich): starten, anhaengen, Haltepunkt, weiter, Schritte, stoppen, Panel
  SPACE d d = debugStart
  SPACE d a = debugAttach
  SPACE d b = debugBreakpoint
  SPACE d B = debugClearBreakpoints
  SPACE d c = debugContinue
  SPACE d n = debugOver
  SPACE d i = debugInto
  SPACE d o = debugOut
  SPACE d x = debugStop
  SPACE d p = debugPanel
  SPACE d s = debugMode
  F3 = debugContinue
  F7 = debugInto
  F8 = debugOver
  Shift-F8 = debugOut
  # wer ruft das auf? (Liste aller Aufrufer)
  SPACE c = callHierarchy
  gh = callHierarchy
  ]d = gotoError
  [d = gotoErrorPrev
  F2 = rename
  SPACE f = format
  SPACE y = openapiView
  SPACE r = rename
  # fehlende Importe (bei mehreren Kandidaten Auswahl), alle Code Actions an der Stelle (wie IntelliJ Alt+ENTER)
  SPACE i = autoImport
  Alt-ENTER = codeActions
  SPACE h = hover
  SPACE e = gotoError
  # aus /mapping/beispiel.map
  gc = kommentar
}

# d, c, y, >, <, gu, gU, g~ warten hier auf Bewegung oder Textobjekt; dd, cc, yy, >>, guu: ganze Zeilen
