# Schreibgeschuetzte Puffer (z. B. die Uebersicht von bindings): wie normal, q schliesst
mode nurlesen extends normal {
  q = close
  # Diff-Ansicht (Leertaste g d, Pull Requests): ENTER in die Datei bzw. an die Codestelle eines Kommentars
  ENTER = diffJump
  ]c = diffNext
  [c = diffPrev
  ]k = diffNextComment
  [k = diffPrevComment
}

mode insert extends base {
  ESC = switchState normal
  Alt-ENTER = codeActions
  Ctrl-c = switchState normal
  ENTER = newline
  BACKSPACE = backspace
  Ctrl-h = backspace
  DELETE = deleteChar
  TAB = indent
  Ctrl-w = insertDeleteWord
  Ctrl-u = insertDeleteLine
  Ctrl-t = insertIndent
  Ctrl-d = insertOutdent
  Ctrl-SPACE = complete
  Ctrl-v = pasteClipboard
  Ctrl-ENTER = sqlRun
  ANY = insertChar
}

# Terminal-Tab: Eingabezeile unten (i/a im Normal-Mode fuehren hierher, ESC zum Markieren/Kopieren im Text)
mode terminal {
  Ctrl-c DIGIT = bankCopy
  Ctrl-c Ctrl-DIGIT = bankCopy
  Ctrl-c b DIGIT DIGIT = bankTransfer
  Ctrl-v DIGIT = bankPaste
  Ctrl-v Ctrl-DIGIT = bankPaste
  ESC = switchState normal
  ENTER = terminalRun
  BACKSPACE = terminalBackspace
  LEFT = terminalLeft
  RIGHT = terminalRight
  Ctrl-h = terminalLeft
  Ctrl-l = terminalRight
  UP = terminalHistoryUp
  DOWN = terminalHistoryDown
  Ctrl-k = terminalHistoryUp
  Ctrl-j = terminalHistoryDown
  Ctrl-c = terminalInterrupt
  Ctrl-v = terminalPaste
  Ctrl-p = fileManager search
  # Vervollstaendigung: Pfade, Befehle, git (Branches, Tags, Remotes), npm-Skripte, Maven-Phasen und -Profile
  TAB = terminalComplete
  ANY = terminalChar
}

# Vorschlagsliste der Terminal-Vervollstaendigung (TAB im Terminal bei mehreren Treffern)
mode termcomplete {
  TAB = terminalCompleteNext
  DOWN = terminalCompleteNext
  Ctrl-n = terminalCompleteNext
  Ctrl-j = terminalCompleteNext
  Shift-TAB = terminalCompletePrev
  UP = terminalCompletePrev
  Ctrl-p = terminalCompletePrev
  Ctrl-k = terminalCompletePrev
  ENTER = terminalCompleteAccept
  ESC = terminalCompleteClose
  Ctrl-c = terminalCompleteClose
  BACKSPACE = terminalCompleteBackspace
  ANY = terminalCompleteChar
}

# Merge-Editor nach Emacs Ediff (Leertaste g m): oben A und B, unten das Ergebnis C
mode merge {
  n = mergeNext
  p = mergePrev
  TAB = mergeNextOpen
  a = mergeTake a
  b = mergeTake b
  + = mergeTake ab
  * = mergeTake ba
  r = mergeRestore
  j = mergeScroll 3
  k = mergeScroll -3
  DOWN = mergeScroll 1
  UP = mergeScroll -1
  Ctrl-j = mergeScroll 3
  Ctrl-k = mergeScroll -3
  PGDN = mergeScroll 20
  PGUP = mergeScroll -20
  e = mergeEdit
  ESC = mergeEdit
  q = mergeQuit
  : = console
}

# OpenAPI-Ansicht fuer YAML mit openapi:/swagger: (oeffnet sich beim Laden, Leertaste y wechselt zum Puffer
# und zurueck): links der Baum, rechts der YAML-Text des gewaehlten Knotens
mode openapi extends base {
  j = openapiMove 1
  k = openapiMove -1
  DOWN = openapiMove 1
  UP = openapiMove -1
  Ctrl-d = openapiMove page
  Ctrl-u = openapiMove -page
  PGDN = openapiMove page
  PGUP = openapiMove -page
  gg = openapiMove -100000
  G = openapiMove 100000
  HOME = openapiMove -100000
  END = openapiMove 100000
  l = openapiOpen
  RIGHT = openapiOpen
  h = openapiClose
  LEFT = openapiClose
  TAB = openapiToggle
  o = openapiToggle
  ENTER = openapiEdit
  e = openapiEdit
  q = openapiEdit
  ESC = openapiEdit esc
  SPACE y = openapiView
  a = openapiAdd
  r = openapiRename
  d = openapiDelete
  J = openapiShift 1
  K = openapiShift -1
  f = openapiFollow
  U = openapiUsages
  p = openapiNextProblem
  / = openapiFilter
  c = openapiGenerate
  u = undo
  Ctrl-r = redo
  Ctrl-z = undo
  Ctrl-j = openapiScroll 3
  Ctrl-k = openapiScroll -3
  Ctrl-o = goBack
  gt = nextTab
  gT = prevTab
  : = console
}

# Pull Requests im SCM-Manager (Leertaste g r): Panel unten wie git status
mode pullrequests {
  j = scmDown
  k = scmUp
  DOWN = scmDown
  UP = scmUp
  Ctrl-j = scmDown
  Ctrl-k = scmUp
  ENTER = scmShow
  a = scmApprove
  x = scmDisapprove
  m = scmMerge
  R = scmReject
  e = scmReviewers
  n = scmCreate
  s = scmFilter
  g = scmRefresh
  w = scmBrowser
  TAB = scmBack
  ESC = scmClose
  q = scmClose
  : = console
}

# Pull Request nebeneinander (ENTER in der Liste), auch der Vergleich mit einem Commit (Leertaste g d):
# links die Dateien, alt und neu Seite an Seite; alle Tasten stehen unten in der Statuszeile
mode prdiff {
  j = prMove 1
  k = prMove -1
  DOWN = prMove 1
  UP = prMove -1
  Ctrl-d = prMove page
  Ctrl-u = prMove -page
  PGDN = prMove page
  PGUP = prMove -page
  gg = prMove -100000
  G = prMove 100000
  # Fenster: Dateiliste, vorher, nachher
  TAB = prWindow 1
  Shift-TAB = prWindow -1
  # Zeilen auswaehlen und in eine Speicherbank kopieren (Strg+C Ziffer, y = Zwischenablage)
  v = prSelect
  V = prSelect
  y = bankCopy 1
  Ctrl-c DIGIT = bankCopy
  Ctrl-c Ctrl-DIGIT = bankCopy
  ]f = prFile 1
  [f = prFile -1
  0 = prFile 0
  n = prChange 1
  p = prChange -1
  ]k = prComment 1
  [k = prComment -1
  ENTER = prOpen
  w = prWrap
  a = prApprove
  x = prDisapprove
  m = prMerge
  R = prReject
  c = prCommentNew
  C = prReply
  e = prReviewers
  u = prRevertFile
  r = prRefresh
  o = prBrowser
  t = prText
  q = prClose
  ESC = prEscape
  : = console
}

# git status (Leertaste g s): Panel unten, ESC schliesst es
mode gitstatus {
  ESC = gitStatusClose
  q = gitStatusClose
  j = gitStatusDown
  k = gitStatusUp
  DOWN = gitStatusDown
  UP = gitStatusUp
  Ctrl-j = gitStatusDown
  Ctrl-k = gitStatusUp
  ENTER = gitStatusOpen
  s = gitStatusStage
  u = gitStatusUnstage
  x = gitStatusDiscard
  d = gitStatusDiff
  DELETE = gitStatusDiscard
  g = gitStatusRefresh
  c = gitCommit
  m = gitMerge
  M = gitMergeBranch
  p = gitPull
  P = gitPush
  : = console
}

# Ergebnistabelle einer Abfrage (Strg+Enter / F5 in SQL-Dateien); jede SQL-Datei hat ihre eigene.
# ESC zurueck in den Text (die Tabelle bleibt, F4 oder Leertaste o wieder hinein), q schliesst sie.
# k ueber der ersten Zeile oder K: Kopfzeile; ENTER dort oeffnet das Filter-/Sortiermenue der Spalte.
mode result {
  Ctrl-c DIGIT = bankCopy
  Ctrl-c Ctrl-DIGIT = bankCopy
  Ctrl-c b DIGIT DIGIT = bankTransfer
  Ctrl-v DIGIT = bankPaste
  Ctrl-v Ctrl-DIGIT = bankPaste
  ESC = resultBack
  F4 = resultBack
  q = resultClose
  K = resultHeader
  f = resultFilter
  F = resultUnfilter
  j = resultDown
  k = resultUp
  h = resultLeft
  l = resultRight
  DOWN = resultDown
  UP = resultUp
  LEFT = resultLeft
  RIGHT = resultRight
  PGDN = resultPageDown
  PGUP = resultPageUp
  Ctrl-d = resultPageDown
  Ctrl-u = resultPageUp
  gg = resultTop
  G = resultBottom
  0 = resultHome
  $ = resultEnd
  HOME = resultHome
  END = resultEnd
  y = resultYank
  # ganze Zeile kommagetrennt: Y in die Zwischenablage, Strg+C r Ziffer in eine Speicherbank
  Y = resultYankRow
  Ctrl-c r DIGIT = bankCopyRow
  Ctrl-a = resultYankAll
  ENTER = resultEnter
  : = console
  Ctrl-p = fileManager search
  F5 = sqlRunFile
  F6 = sqlAccount
}

# Debug-Modus: haelt der Debugger an, springt der Editor in die Datei (Tab) und in diesen Mode.
# Schritte mit einzelnen Tasten, Bewegungen zum Umsehen; ESC = Text bearbeiten (Leertaste d s zurueck)
mode debugstep extends motions {
  ESC = debugLeave
  n = debugOver
  i = debugInto
  o = debugOut
  c = debugContinue
  p = debugBreakpoint
  x = debugStop
  TAB = debugSwitch 1
  Shift-TAB = debugSwitch -1
  F3 = debugContinue
  F7 = debugInto
  F8 = debugOver
  Shift-F8 = debugOut
  : = console
}

