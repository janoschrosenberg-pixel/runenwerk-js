# keymap.config - Tastenbelegung von RUNENWERK JS
#
# Rechts steht ein Befehl wie im Terminal (:): eine Funktion des Editors oder eine
# Mapping-Funktion aus /mapping, mit Argumenten ohne Klammern und Anfuehrungszeichen.
# Tasten: Zeichen, Folgen (dd), ESC ENTER TAB Shift-TAB BACKSPACE DELETE INSERT UP DOWN LEFT RIGHT
# HOME END PGUP PGDN SPACE F1..F12 Ctrl-a..Ctrl-z Ctrl-SPACE Ctrl-+ Ctrl--;
# ANY = jede andere druckbare Taste (Zeichen als Argument).
# Auf dem Mac gilt Cmd wie Ctrl.

set layout de_DE
set start normal

# eigenes Layout: Zeichen ersetzen (aktiv mit: set layout custom)
layout custom extends de_DE {
  z = y
  y = z
}

mode base {
  F9 = compile
  F10 = compileFast
  F11 = fullscreen
  Ctrl-s = save
  Ctrl-p = fileManager search
  Ctrl-q = quit
  Ctrl-+ = fontBigger
  Ctrl-- = fontSmaller
  UP = cursorUp
  DOWN = cursorDown
  LEFT = cursorLeft
  RIGHT = cursorRight
  HOME = lineStart
  END = lineEnd
  PGUP = pageUp
  PGDN = pageDown
}

mode normal extends base {
  h = cursorLeft
  j = cursorDown
  k = cursorUp
  l = cursorRight
  0 = lineStart
  $ = lineEnd
  ^ = firstNonBlank
  w = wordForward
  b = wordBack
  gg = gotoTop
  G = gotoBottom
  i = switchState insert
  a = appendAfter
  A = appendLineEnd
  I = insertLineStart
  o = openLineBelow
  O = openLineAbove
  x = deleteChar
  DELETE = deleteChar
  dd = deleteLine
  dw = deleteWord
  D = deleteToLineEnd
  cw = changeWord
  C = changeToLineEnd
  yy = yankLine
  p = paste
  P = pasteBefore
  u = undo
  Ctrl-r = redo
  Ctrl-z = undo
  Ctrl-y = redo
  : = console
  / = find
  n = findNext
  N = findPrev
  * = findWord
  ESC = clearSearch
  gt = nextTab
  gT = prevTab
  ZZ = wq
  gd = gotoDefinition
  F12 = gotoDefinition
  gr = references
  Ctrl-o = goBack
  ge = gotoError
  K = hover
  Ctrl-k = hover
  Ctrl-f = format
  F2 = rename
  # aus /mapping/beispiel.map
  gc = kommentar
  Ctrl-d = zeileDoppeln
}

mode insert extends base {
  ESC = switchState normal
  ENTER = newline
  BACKSPACE = backspace
  DELETE = deleteChar
  TAB = indent
  Ctrl-SPACE = complete
  Ctrl-v = pasteClipboard
  ANY = insertChar
}

# Vorschlaege des Language Servers (Strg+Leertaste, oder von selbst nach einem Punkt)
mode complete {
  ESC = completeClose
  UP = completeUp
  DOWN = completeDown
  Ctrl-p = completeUp
  Ctrl-n = completeDown
  PGUP = completePageUp
  PGDN = completePageDown
  ENTER = completeAccept
  TAB = completeAccept
  BACKSPACE = completeBackspace
  Ctrl-SPACE = complete
  ANY = completeChar
}

mode console {
  ESC = consoleClose
  ENTER = consoleRun
  BACKSPACE = consoleBackspace
  UP = consoleUp
  DOWN = consoleDown
  Ctrl-l = consoleClear
  Ctrl-c = stop
  Ctrl-p = fileManager search
  ANY = consoleChar
}

# Eingabe in einem Fenster (z. B. Arbeitsordner, Ziel beim Kopieren)
mode popup {
  ESC = popupClose
  ENTER = popupRun
  BACKSPACE = popupBackspace
  TAB = popupComplete
  Ctrl-u = popupClear
  Ctrl-v = popupPaste
  ANY = popupChar
}

# Dateimanager (Strg+P): Tasten in beiden Modes wie beim Norton Commander
mode fmbase {
  F10 = fmClose
  Ctrl-p = fmClose
  UP = fmUp
  DOWN = fmDown
  PGUP = fmPageUp
  PGDN = fmPageDown
  TAB = fmSwitch
  ENTER = fmEnter
  F1 = fmHelp
  F2 = fmNewFile
  F3 = fmView
  F4 = fmOpen
  F5 = fmCopy
  F6 = fmMove
  F7 = fmMkdir
  F8 = fmDelete
  Ctrl-r = fmRefresh
  Ctrl-w = fmWorkdir
}

mode commander extends fmbase {
  ESC = fmClose
  k = fmUp
  j = fmDown
  HOME = fmHome
  END = fmEnd
  BACKSPACE = fmParent
  DELETE = fmDelete
  r = fmRename
  / = fmFind
  Ctrl-f = fmFind
}

# Suchfeld im Dateimanager: links Dateinamen, rechts Treffer im Inhalt
mode fmsearch extends fmbase {
  ESC = fmSearchDone
  BACKSPACE = fmSearchBackspace
  Ctrl-u = fmSearchClear
  ANY = fmSearchChar
}
