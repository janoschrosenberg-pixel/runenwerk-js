  ib = textObject ib
  ab = textObject ab
  i{ = textObject i{
  a{ = textObject a{
  i} = textObject i}
  a} = textObject a}
  iB = textObject iB
  aB = textObject aB
  i[ = textObject i[
  a[ = textObject a[
  i] = textObject i]
  a] = textObject a]
  i< = textObject i<
  a< = textObject a<
  i> = textObject i>
