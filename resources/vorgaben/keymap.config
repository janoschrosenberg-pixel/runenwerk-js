  Shift-TAB = debugSwitch -1
  ENTER = debugEnter
  l = debugEnter
  K = debugInspect
  y = debugYank
  c = debugContinue
  n = debugOver
  i = debugInto
  o = debugOut
  x = debugStop
  F3 = debugContinue
  F7 = debugInto
  F8 = debugOver
  Shift-F8 = debugOut
