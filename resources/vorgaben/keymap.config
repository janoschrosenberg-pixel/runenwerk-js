# keymap.config - Tastenbelegung von RUNENWERK JS
#
# Rechts steht ein Befehl wie im Terminal (:): eine Funktion des Editors oder eine
# Mapping-Funktion aus /mapping, mit Argumenten ohne Klammern und Anfuehrungszeichen.
# Tasten: Zeichen, Folgen (dd), ESC ENTER TAB Shift-TAB BACKSPACE DELETE INSERT UP DOWN LEFT RIGHT
# HOME END PGUP PGDN SPACE F1..F12 Ctrl-a..Ctrl-z Ctrl-SPACE Ctrl-+ Ctrl--;
# ANY = jede andere druckbare Taste (Zeichen als Argument).
# Auf dem Mac gilt Cmd wie Ctrl. "# = ..." belegt die Taste # (sonst ist # ein Kommentar).

set layout de_DE
set start normal

# eigenes Layout: Zeichen ersetzen (aktiv mit: set layout custom)
layout custom extends de_DE {
  z = y
  y = z
}

mode base {
  F9 = compile
  F10 = compileFast
  F11 = fullscreen
  Ctrl-s = save
  Ctrl-p = fileManager search
  Ctrl-q = quit
  Ctrl-+ = fontBigger
  Ctrl-- = fontSmaller
  UP = cursorUp
  DOWN = cursorDown
  LEFT = cursorLeft
  RIGHT = cursorRight
  HOME = lineStart
  END = lineEnd
  PGUP = pageUp
  PGDN = pageDown
}

# Bewegungen und Zaehler: gelten in normal, visual und operator (d, c, y, ... warten auf eine Bewegung)
mode motions extends base {
  1 = count 1
  2 = count 2
  3 = count 3
  4 = count 4
  5 = count 5
  6 = count 6
  7 = count 7
  8 = count 8
  9 = count 9
  0 = countZero
  ESC = cancel
  h = motion h
  j = motion j
  k = motion k
  l = motion l
  LEFT = motion h
  DOWN = motion j
  UP = motion k
  RIGHT = motion l
  BACKSPACE = motion h
  HOME = motion 0
  END = motion $
  w = motion w
  W = motion W
  b = motion b
  B = motion B
  e = motion e
  E = motion E
  ge = motion ge
  gE = motion gE
  ^ = motion ^
  $ = motion $
  _ = motion _
  + = motion +
  - = motion -
  gg = motion gg
  G = motion G
  H = motion H
  M = motion M
  L = motion L
  f = awaitChar motion f
  t = awaitChar motion t
  F = awaitChar motion F
  T = awaitChar motion T
  ; = motion ;
  , = motion ,
  % = motion %
  { = motion {
  } = motion }
  n = motion n
  N = motion N
  ' = awaitChar gotoMarkLine
  ` = awaitChar gotoMark
  " = awaitChar selectRegister
  Ctrl-d = scroll halfDown
  Ctrl-u = scroll halfUp
  Ctrl-f = scroll pageDown
  Ctrl-b = scroll pageUp
  PGDN = scroll pageDown
  PGUP = scroll pageUp
  Ctrl-e = scroll lineDown
  Ctrl-y = scroll lineUp
  zz = scroll center
  zt = scroll top
  zb = scroll bottom
}

mode normal extends motions {
  ENTER = motion ENTER
  i = switchState insert
  a = appendAfter
  A = appendLineEnd
  I = insertLineStart
  o = openLineBelow
  O = openLineAbove
  # Operatoren: danach eine Bewegung oder ein Textobjekt (dw, ciw, yap, >}, gUiw, dd ...)
  d = operator d
  c = operator c
  y = operator y
  > = operator >
  < = operator <
  gu = operator gu
  gU = operator gU
  g~ = operator g~
  x = opMotion d l
  DELETE = opMotion d l
  X = opMotion d h
  s = opMotion c l
  S = opLine c
  C = opMotion c $
  D = opMotion d $
  Y = opLine y
  p = paste
  P = pasteBefore
  u = undo
  Ctrl-r = redo
  Ctrl-z = undo
  . = dot
  r = awaitChar replaceChar
  R = switchState replace
  ~ = toggleCase
  J = join
  gJ = joinNoSpace
  Ctrl-a = increment
  Ctrl-x = decrement
  v = visual v
  V = visual V
  Ctrl-v = visual b
  gv = reselect
  q = macroQ
  @ = awaitChar macroPlay
  m = awaitChar setMark
  : = console
  / = find
  ? = findBack
  * = findWord
  # = findWordBack
  gt = nextTab
  gT = prevTab
  ZZ = wq
  ZQ = q!
  # Language Server
  gd = gotoDefinition
  F12 = gotoDefinition
  gr = references
  Ctrl-o = goBack
  K = hover
  Ctrl-k = hover
  ]d = gotoError
  [d = gotoErrorPrev
  F2 = rename
  SPACE f = format
  SPACE r = rename
  SPACE h = hover
  SPACE e = gotoError
  # aus /mapping/beispiel.map
  gc = kommentar
}

# d, c, y, >, <, gu, gU, g~ warten hier auf Bewegung oder Textobjekt; dd, cc, yy, >>, guu: ganze Zeilen
mode operator extends motions {
  d = operatorLine
  c = operatorLine
  y = operatorLine
  > = operatorLine
  < = operatorLine
  u = operatorLine
  U = operatorLine
  ~ = operatorLine
  iw = textObject iw
  aw = textObject aw
  iW = textObject iW
  aW = textObject aW
  i" = textObject i"
  a" = textObject a"
  i' = textObject i'
  a' = textObject a'
  i` = textObject i`
  a` = textObject a`
  i( = textObject i(
  a( = textObject a(
  i) = textObject i)
  a) = textObject a)
  ib = textObject ib
  ab = textObject ab
  i{ = textObject i{
  a{ = textObject a{
  i} = textObject i}
  a} = textObject a}
  iB = textObject iB
  aB = textObject aB
  i[ = textObject i[
  a[ = textObject a[
  i] = textObject i]
  a] = textObject a]
  i< = textObject i<
  a< = textObject a<
  i> = textObject i>
  a> = textObject a>
  it = textObject it
  at = textObject at
  ip = textObject ip
  ap = textObject ap
}

# wartet auf ein Zeichen (f t F T r m ' ` " q @)
mode char {
  ESC = cancel
  ANY = charArg
}

mode visual extends motions {
  ESC = visualExit
  Ctrl-c = visualExit
  v = visual v
  V = visual V
  Ctrl-v = visual b
  o = visualSwap
  O = visualSwap
  d = visualOp d
  x = visualOp x
  DELETE = visualOp d
  D = visualOp D
  X = visualOp X
  y = visualOp y
  Y = visualOp Y
  c = visualOp c
  s = visualOp s
  C = visualOp C
  S = visualOp S
  R = visualOp R
  > = visualOp >
  < = visualOp <
  ~ = visualOp ~
  u = visualOp u
  U = visualOp U
  J = visualOp J
  gJ = visualOp gJ
  p = visualOp p
  P = visualOp P
  r = awaitChar visualOp r
  I = visualOp I
  A = visualOp A
  : = visualConsole
  iw = textObject iw
  aw = textObject aw
  iW = textObject iW
  aW = textObject aW
  i" = textObject i"
  a" = textObject a"
  i' = textObject i'
  a' = textObject a'
  i` = textObject i`
  a` = textObject a`
  i( = textObject i(
  a( = textObject a(
  i) = textObject i)
  a) = textObject a)
  ib = textObject ib
  ab = textObject ab
  i{ = textObject i{
  a{ = textObject a{
  i} = textObject i}
  a} = textObject a}
  iB = textObject iB
  aB = textObject aB
  i[ = textObject i[
  a[ = textObject a[
  i] = textObject i]
  a] = textObject a]
  i< = textObject i<
  a< = textObject a<
  i> = textObject i>
  a> = textObject a>
  it = textObject it
  at = textObject at
  ip = textObject ip
  ap = textObject ap
}

mode insert extends base {
  ESC = switchState normal
  Ctrl-c = switchState normal
  ENTER = newline
  BACKSPACE = backspace
  Ctrl-h = backspace
  DELETE = deleteChar
  TAB = indent
  Ctrl-w = insertDeleteWord
  Ctrl-u = insertDeleteLine
  Ctrl-t = insertIndent
  Ctrl-d = insertOutdent
  Ctrl-SPACE = complete
  Ctrl-v = pasteClipboard
  ANY = insertChar
}

mode replace extends base {
  ESC = switchState normal
  Ctrl-c = switchState normal
  BACKSPACE = cursorLeft
  ENTER = newline
  ANY = replaceTyped
}

# Vorschlaege des Language Servers (Strg+Leertaste, oder von selbst nach einem Punkt)
mode complete {
  ESC = completeClose
  UP = completeUp
  DOWN = completeDown
  Ctrl-p = completeUp
  Ctrl-n = completeDown
  PGUP = completePageUp
  PGDN = completePageDown
  ENTER = completeAccept
  TAB = completeAccept
  BACKSPACE = completeBackspace
  Ctrl-SPACE = complete
  ANY = completeChar
}

mode console {
  ESC = consoleClose
  ENTER = consoleRun
  BACKSPACE = consoleBackspace
  UP = consoleUp
  DOWN = consoleDown
  Ctrl-l = consoleClear
  Ctrl-c = stop
  Ctrl-p = fileManager search
  ANY = consoleChar
}

# Eingabe in einem Fenster (z. B. Arbeitsordner, Ziel beim Kopieren)
mode popup {
  ESC = popupClose
  ENTER = popupRun
  BACKSPACE = popupBackspace
  TAB = popupComplete
  Ctrl-u = popupClear
  Ctrl-v = popupPaste
  ANY = popupChar
}

# Dateimanager (Strg+P): Tasten in beiden Modes wie beim Norton Commander
mode fmbase {
  F10 = fmClose
  Ctrl-p = fmClose
  UP = fmUp
  DOWN = fmDown
  PGUP = fmPageUp
  PGDN = fmPageDown
  TAB = fmSwitch
  ENTER = fmEnter
  F1 = fmHelp
  F2 = fmNewFile
  F3 = fmView
  F4 = fmOpen
  F5 = fmCopy
  F6 = fmMove
  F7 = fmMkdir
  F8 = fmDelete
  Ctrl-r = fmRefresh
  Ctrl-w = fmWorkdir
}

mode commander extends fmbase {
  ESC = fmClose
  k = fmUp
  j = fmDown
  HOME = fmHome
  END = fmEnd
  BACKSPACE = fmParent
  DELETE = fmDelete
  r = fmRename
  / = fmFind
  Ctrl-f = fmFind
}

# Suchfeld im Dateimanager: links Dateinamen, rechts Treffer im Inhalt
mode fmsearch extends fmbase {
  ESC = fmSearchDone
  BACKSPACE = fmSearchBackspace
  Ctrl-u = fmSearchClear
  ANY = fmSearchChar
}
