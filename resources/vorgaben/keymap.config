  d = operatorLine
  c = operatorLine
  y = operatorLine
  > = operatorLine
  < = operatorLine
  u = operatorLine
  U = operatorLine
  ~ = operatorLine
  iw = textObject iw
  aw = textObject aw
  iW = textObject iW
  aW = textObject aW
  i" = textObject i"
  a" = textObject a"
  i' = textObject i'
  a' = textObject a'
  i` = textObject i`
  a` = textObject a`
  i( = textObject i(
  a( = textObject a(
  i) = textObject i)
  a) = textObject a)
  ib = textObject ib
  ab = textObject ab
  i{ = textObject i{
  a{ = textObject a{
  i} = textObject i}
  a} = textObject a}
  iB = textObject iB
  aB = textObject aB
  i[ = textObject i[
  a[ = textObject a[
  i] = textObject i]
  a] = textObject a]
  i< = textObject i<
  a< = textObject a<
  i> = textObject i>
  a> = textObject a>
  it = textObject it
  at = textObject at
  ip = textObject ip
  ap = textObject ap
  im = textObject im
  am = textObject am
  if = textObject if
  af = textObject af
}

