# keymap.config - Tastenbelegung von RUNENWERK JS
#
# Rechts steht ein Befehl wie im Terminal (:): eine Funktion des Editors oder eine
# Mapping-Funktion aus /mapping, mit Argumenten ohne Klammern und Anfuehrungszeichen.
# Tasten: Zeichen, Folgen (dd), ESC ENTER TAB Shift-TAB BACKSPACE DELETE INSERT UP DOWN LEFT RIGHT
# HOME END PGUP PGDN SPACE F1..F12 Ctrl-a..Ctrl-z Ctrl-SPACE Ctrl-+ Ctrl--;
# ANY = jede andere druckbare Taste (Zeichen als Argument).
# Auf dem Mac gilt Cmd wie Ctrl. "# = ..." belegt die Taste # (sonst ist # ein Kommentar).

set layout de_DE
set start normal

# eigenes Layout: Zeichen ersetzen (aktiv mit: set layout custom)
layout custom extends de_DE {
  z = y
  y = z
}

mode base {
  # Speicherbaenke: Strg+C Ziffer kopiert, Strg+V Ziffer fuegt ein (0 = Systemzwischenablage), Ziffer auch mit Strg
  Ctrl-c DIGIT = bankCopy
  Ctrl-c Ctrl-DIGIT = bankCopy
  Ctrl-v DIGIT = bankPaste
  Ctrl-v Ctrl-DIGIT = bankPaste
  F9 = compile
  F10 = compileFast
  F11 = fullscreen
  Ctrl-s = save
  Ctrl-p = fileManager search
  Ctrl-q = quit
  Ctrl-+ = fontBigger
  Ctrl-- = fontSmaller
  UP = cursorUp
  DOWN = cursorDown
  LEFT = cursorLeft
  RIGHT = cursorRight
  HOME = lineStart
  END = lineEnd
  PGUP = pageUp
  PGDN = pageDown
}

# Bewegungen und Zaehler: gelten in normal, visual und operator (d, c, y, ... warten auf eine Bewegung)
mode motions extends base {
  1 = count 1
  2 = count 2
  3 = count 3
  4 = count 4
  5 = count 5
  6 = count 6
  7 = count 7
  8 = count 8
  9 = count 9
  0 = countZero
  ESC = cancel
  h = motion h
  j = motion j
  k = motion k
  l = motion l
  LEFT = motion h
  DOWN = motion j
  UP = motion k
  RIGHT = motion l
  BACKSPACE = motion h
  HOME = motion 0
  END = motion $
  w = motion w
  W = motion W
  b = motion b
  B = motion B
  e = motion e
  E = motion E
  ge = motion ge
  gE = motion gE
  ^ = motion ^
  $ = motion $
  _ = motion _
  + = motion +
  - = motion -
  gg = motion gg
  G = motion G
  H = motion H
  M = motion M
  L = motion L
  f = awaitChar motion f
  t = awaitChar motion t
  F = awaitChar motion F
  T = awaitChar motion T
  ; = motion ;
  , = motion ,
  % = motion %
  { = motion {
  } = motion }
  n = motion n
  N = motion N
  ' = awaitChar gotoMarkLine
  ` = awaitChar gotoMark
  " = awaitChar selectRegister
  Ctrl-d = scroll halfDown
  Ctrl-u = scroll halfUp
  Ctrl-f = scroll pageDown
  Ctrl-b = scroll pageUp
  PGDN = scroll pageDown
  PGUP = scroll pageUp
  Ctrl-e = scroll lineDown
  Ctrl-y = scroll lineUp
  Ctrl-l = scroll lineRight
  Ctrl-h = scroll lineLeft
  zz = scroll center
  zt = scroll top
  zb = scroll bottom
}

mode normal extends motions {
  ENTER = motion ENTER
  i = switchState insert
  a = appendAfter
  A = appendLineEnd
  I = insertLineStart
  o = openLineBelow
  O = openLineAbove
  # Operatoren: danach eine Bewegung oder ein Textobjekt (dw, ciw, yap, >}, gUiw, dd ...)
  d = operator d
  c = operator c
  y = operator y
  > = operator >
  < = operator <
  gu = operator gu
  gU = operator gU
  g~ = operator g~
  x = opMotion d l
  DELETE = opMotion d l
  X = opMotion d h
  s = opMotion c l
  S = opLine c
  C = opMotion c $
  D = opMotion d $
  Y = opLine y
  p = paste
  P = pasteBefore
  u = undo
  Ctrl-r = redo
  Ctrl-z = undo
  . = dot
  r = awaitChar replaceChar
  R = switchState replace
  ~ = toggleCase
  J = join
  gJ = joinNoSpace
  Ctrl-a = increment
  Ctrl-x = decrement
  v = visual v
  V = visual V
  Ctrl-v = visual b
  Ctrl-V = visual b
  gv = reselect
  q = macroQ
  @ = awaitChar macroPlay
  m = awaitChar setMark
  : = console
  / = find
  ? = findBack
  * = findWord
  # = findWordBack
  gt = nextTab
  gT = prevTab
  ZZ = wq
  ZQ = q!
  # Language Server
  gd = gotoDefinition
  F12 = gotoDefinition
  gr = references
  Ctrl-o = goBack
  K = hover
  # von Methode zu Methode (TypeScript und Java, ueber den Language Server)
  ]m = methodNext
  [m = methodPrev
  Ctrl-j = methodNext
  Ctrl-k = methodPrev
  # Git (Repo der aktuellen Datei): Branch, pull, push, commit, status, reset --hard, Merge-Editor, Blame
  SPACE b = gitBranch
  SPACE g b = gitBranch
  SPACE g t = gitBranch ts
  SPACE g j = gitBranch java
  SPACE g p = gitPull
  SPACE g P = gitPush
  SPACE g c = gitCommit
  SPACE g s = gitStatus
  SPACE g R = gitReset
  SPACE g m = gitMerge
  SPACE g B = gitBlame
  SPACE g a = gitBlame
  # Terminal als eigener Tab (beliebig viele)
  SPACE t = terminal
  # SQL-Dateien: Statement am Cursor, ganze Datei, Konto wechseln, Ergebnis, Commit/Rollback/Abbruch
  Ctrl-ENTER = sqlRun
  F5 = sqlRunFile
  F6 = sqlAccount
  SPACE o = resultFocus
  F4 = resultFocus
  SPACE O = resultClose
  SPACE s m = sqlMetaRefresh
  SPACE s c = sqlCommit
  SPACE s r = sqlRollback
  SPACE s x = sqlCancel
  SPACE s s = sqlRun
  # neue, leere SQL-Datei fuer schnelle Abfragen
  SPACE q = sqlScratch
  # Spring Boot (Profil aus spring.profile, Vorgabe dev): starten, Profil waehlen, mit Debugger, stoppen
  SPACE a a = springRun
  SPACE a p = springProfile
  SPACE a d = springDebug
  SPACE a b = springBuild
  SPACE a x = springStop
  # Debugger (Java und JS/TS gleich): starten, anhaengen, Haltepunkt, weiter, Schritte, stoppen, Panel
  SPACE d d = debugStart
  SPACE d a = debugAttach
  SPACE d b = debugBreakpoint
  SPACE d B = debugClearBreakpoints
  SPACE d c = debugContinue
  SPACE d n = debugOver
  SPACE d i = debugInto
  SPACE d o = debugOut
  SPACE d x = debugStop
  SPACE d p = debugPanel
  F3 = debugContinue
  F7 = debugInto
  F8 = debugOver
  Shift-F8 = debugOut
  # wer ruft das auf? (Liste aller Aufrufer)
  SPACE c = callHierarchy
  gh = callHierarchy
  ]d = gotoError
  [d = gotoErrorPrev
  F2 = rename
  SPACE f = format
  SPACE r = rename
  SPACE h = hover
  SPACE e = gotoError
  # aus /mapping/beispiel.map
  gc = kommentar
}

# d, c, y, >, <, gu, gU, g~ warten hier auf Bewegung oder Textobjekt; dd, cc, yy, >>, guu: ganze Zeilen
mode operator extends motions {
  d = operatorLine
  c = operatorLine
  y = operatorLine
  > = operatorLine
  < = operatorLine
  u = operatorLine
  U = operatorLine
  ~ = operatorLine
  iw = textObject iw
  aw = textObject aw
  iW = textObject iW
  aW = textObject aW
  i" = textObject i"
  a" = textObject a"
  i' = textObject i'
  a' = textObject a'
  i` = textObject i`
  a` = textObject a`
  i( = textObject i(
  a( = textObject a(
  i) = textObject i)
  a) = textObject a)
  ib = textObject ib
  ab = textObject ab
  i{ = textObject i{
  a{ = textObject a{
  i} = textObject i}
  a} = textObject a}
  iB = textObject iB
  aB = textObject aB
  i[ = textObject i[
  a[ = textObject a[
  i] = textObject i]
  a] = textObject a]
  i< = textObject i<
  a< = textObject a<
  i> = textObject i>
  a> = textObject a>
  it = textObject it
  at = textObject at
  ip = textObject ip
  ap = textObject ap
}

# wartet auf ein Zeichen (f t F T r m ' ` " q @)
mode char {
  ESC = cancel
  ANY = charArg
}

mode visual extends motions {
  ESC = visualExit
  Ctrl-c = visualExit
  v = visual v
  V = visual V
  Ctrl-v = visual b
  Ctrl-V = visual b
  o = visualSwap
  O = visualSwap
  d = visualOp d
  x = visualOp x
  DELETE = visualOp d
  D = visualOp D
  X = visualOp X
  y = visualOp y
  Y = visualOp Y
  c = visualOp c
  s = visualOp s
  C = visualOp C
  S = visualOp S
  R = visualOp R
  > = visualOp >
  < = visualOp <
  ~ = visualOp ~
  u = visualOp u
  U = visualOp U
  J = visualOp J
  gJ = visualOp gJ
  p = visualOp p
  P = visualOp P
  r = awaitChar visualOp r
  I = visualOp I
  A = visualOp A
  : = visualConsole
  Ctrl-ENTER = sqlRun
  F5 = sqlRun
  SPACE s s = sqlRun
  iw = textObject iw
  aw = textObject aw
  iW = textObject iW
  aW = textObject aW
  i" = textObject i"
  a" = textObject a"
  i' = textObject i'
  a' = textObject a'
  i` = textObject i`
  a` = textObject a`
  i( = textObject i(
  a( = textObject a(
  i) = textObject i)
  a) = textObject a)
  ib = textObject ib
  ab = textObject ab
  i{ = textObject i{
  a{ = textObject a{
  i} = textObject i}
  a} = textObject a}
  iB = textObject iB
  aB = textObject aB
  i[ = textObject i[
  a[ = textObject a[
  i] = textObject i]
  a] = textObject a]
  i< = textObject i<
  a< = textObject a<
  i> = textObject i>
  a> = textObject a>
  it = textObject it
  at = textObject at
  ip = textObject ip
  ap = textObject ap
}

mode insert extends base {
  ESC = switchState normal
  Ctrl-c = switchState normal
  ENTER = newline
  BACKSPACE = backspace
  Ctrl-h = backspace
  DELETE = deleteChar
  TAB = indent
  Ctrl-w = insertDeleteWord
  Ctrl-u = insertDeleteLine
  Ctrl-t = insertIndent
  Ctrl-d = insertOutdent
  Ctrl-SPACE = complete
  Ctrl-v = pasteClipboard
  Ctrl-ENTER = sqlRun
  ANY = insertChar
}

# Terminal-Tab: Eingabezeile unten (i/a im Normal-Mode fuehren hierher, ESC zum Markieren/Kopieren im Text)
mode terminal {
  Ctrl-c DIGIT = bankCopy
  Ctrl-c Ctrl-DIGIT = bankCopy
  Ctrl-v DIGIT = bankPaste
  Ctrl-v Ctrl-DIGIT = bankPaste
  ESC = switchState normal
  ENTER = terminalRun
  BACKSPACE = terminalBackspace
  LEFT = terminalLeft
  RIGHT = terminalRight
  Ctrl-h = terminalLeft
  Ctrl-l = terminalRight
  UP = terminalHistoryUp
  DOWN = terminalHistoryDown
  Ctrl-k = terminalHistoryUp
  Ctrl-j = terminalHistoryDown
  Ctrl-c = terminalInterrupt
  Ctrl-v = terminalPaste
  Ctrl-p = fileManager search
  ANY = terminalChar
}

# Merge-Editor nach Emacs Ediff (Leertaste g m): oben A und B, unten das Ergebnis C
mode merge {
  n = mergeNext
  p = mergePrev
  TAB = mergeNextOpen
  a = mergeTake a
  b = mergeTake b
  + = mergeTake ab
  * = mergeTake ba
  r = mergeRestore
  j = mergeScroll 3
  k = mergeScroll -3
  DOWN = mergeScroll 1
  UP = mergeScroll -1
  Ctrl-j = mergeScroll 3
  Ctrl-k = mergeScroll -3
  PGDN = mergeScroll 20
  PGUP = mergeScroll -20
  e = mergeEdit
  ESC = mergeEdit
  q = mergeQuit
  : = console
}

# git status (Leertaste g s): Panel unten, ESC schliesst es
mode gitstatus {
  ESC = gitStatusClose
  q = gitStatusClose
  j = gitStatusDown
  k = gitStatusUp
  DOWN = gitStatusDown
  UP = gitStatusUp
  Ctrl-j = gitStatusDown
  Ctrl-k = gitStatusUp
  ENTER = gitStatusOpen
  s = gitStatusStage
  u = gitStatusUnstage
  g = gitStatusRefresh
  c = gitCommit
  m = gitMerge
  p = gitPull
  P = gitPush
  : = console
}

# Ergebnistabelle einer Abfrage (Strg+Enter / F5 in SQL-Dateien); jede SQL-Datei hat ihre eigene.
# ESC zurueck in den Text (die Tabelle bleibt, F4 oder Leertaste o wieder hinein), q schliesst sie.
# k ueber der ersten Zeile oder K: Kopfzeile; ENTER dort oeffnet das Filter-/Sortiermenue der Spalte.
mode result {
  Ctrl-c DIGIT = bankCopy
  Ctrl-c Ctrl-DIGIT = bankCopy
  Ctrl-v DIGIT = bankPaste
  Ctrl-v Ctrl-DIGIT = bankPaste
  ESC = resultBack
  F4 = resultBack
  q = resultClose
  K = resultHeader
  f = resultFilter
  F = resultUnfilter
  j = resultDown
  k = resultUp
  h = resultLeft
  l = resultRight
  DOWN = resultDown
  UP = resultUp
  LEFT = resultLeft
  RIGHT = resultRight
  PGDN = resultPageDown
  PGUP = resultPageUp
  Ctrl-d = resultPageDown
  Ctrl-u = resultPageUp
  gg = resultTop
  G = resultBottom
  0 = resultHome
  $ = resultEnd
  HOME = resultHome
  END = resultEnd
  y = resultYank
  Y = resultYankRow
  Ctrl-a = resultYankAll
  ENTER = resultEnter
  : = console
  Ctrl-p = fileManager search
  F5 = sqlRunFile
  F6 = sqlAccount
}

# Debug-Panel (Leertaste d p): Aufrufstapel links, Variablen rechts
mode debug {
  Ctrl-c DIGIT = bankCopy
  Ctrl-c Ctrl-DIGIT = bankCopy
  Ctrl-v DIGIT = bankPaste
  Ctrl-v Ctrl-DIGIT = bankPaste
  ESC = debugBack
  q = debugClose
  j = debugDown
  k = debugUp
  DOWN = debugDown
  UP = debugUp
  TAB = debugSwitch
  ENTER = debugEnter
  l = debugEnter
  y = debugYank
  c = debugContinue
  n = debugOver
  i = debugInto
  o = debugOut
  x = debugStop
  F3 = debugContinue
  F7 = debugInto
  F8 = debugOver
  Shift-F8 = debugOut
  : = console
}

# Auswahlliste (Branch, Datenbankkonto, Aufrufer, Profil): tippen filtert
mode picker {
  Ctrl-c DIGIT = bankCopy
  Ctrl-c Ctrl-DIGIT = bankCopy
  Ctrl-v DIGIT = bankPaste
  Ctrl-v Ctrl-DIGIT = bankPaste
  ESC = pickerClose
  ENTER = pickerAccept
  TAB = pickerAccept
  UP = pickerUp
  DOWN = pickerDown
  Ctrl-p = pickerUp
  Ctrl-n = pickerDown
  Ctrl-k = pickerUp
  Ctrl-j = pickerDown
  BACKSPACE = pickerBackspace
  ANY = pickerChar
}

mode replace extends base {
  ESC = switchState normal
  Ctrl-c = switchState normal
  BACKSPACE = cursorLeft
  ENTER = newline
  ANY = replaceTyped
}

# Vorschlaege des Language Servers (Strg+Leertaste, oder von selbst nach einem Punkt)
mode complete {
  ESC = completeClose
  UP = completeUp
  DOWN = completeDown
  Ctrl-p = completeUp
  Ctrl-n = completeDown
  PGUP = completePageUp
  PGDN = completePageDown
  Ctrl-j = completeDown
  Ctrl-k = completeUp
  ENTER = completeAccept
  TAB = completeAccept
  BACKSPACE = completeBackspace
  Ctrl-SPACE = complete
  ANY = completeChar
}

mode console {
  Ctrl-c DIGIT = bankCopy
  Ctrl-c Ctrl-DIGIT = bankCopy
  Ctrl-v DIGIT = bankPaste
  Ctrl-v Ctrl-DIGIT = bankPaste
  ESC = consoleClose
  ENTER = consoleRun
  BACKSPACE = consoleBackspace
  UP = consoleUp
  DOWN = consoleDown
  Ctrl-k = consoleUp
  Ctrl-j = consoleDown
  Ctrl-l = consoleClear
  Ctrl-c = stop
  Ctrl-p = fileManager search
  ANY = consoleChar
}

# Eingabe in einem Fenster (z. B. Arbeitsordner, Ziel beim Kopieren)
mode popup {
  Ctrl-c DIGIT = bankCopy
  Ctrl-c Ctrl-DIGIT = bankCopy
  Ctrl-v DIGIT = bankPaste
  Ctrl-v Ctrl-DIGIT = bankPaste
  ESC = popupClose
  ENTER = popupRun
  BACKSPACE = popupBackspace
  TAB = popupComplete
  Ctrl-u = popupClear
  Ctrl-v = popupPaste
  ANY = popupChar
}

# Dateimanager (Strg+P): Tasten in beiden Modes wie beim Norton Commander
mode fmbase {
  Ctrl-c DIGIT = bankCopy
  Ctrl-c Ctrl-DIGIT = bankCopy
  Ctrl-v DIGIT = bankPaste
  Ctrl-v Ctrl-DIGIT = bankPaste
  F10 = fmClose
  Ctrl-p = fmClose
  UP = fmUp
  DOWN = fmDown
  PGUP = fmPageUp
  PGDN = fmPageDown
  TAB = fmSwitch
  ENTER = fmEnter
  F1 = fmHelp
  F2 = fmNewFile
  F3 = fmView
  F4 = fmOpen
  F5 = fmCopy
  F6 = fmMove
  F7 = fmMkdir
  F8 = fmDelete
  Ctrl-r = fmRefresh
  Ctrl-w = fmWorkdir
  # Strg+hjkl geht auch im Suchfeld (dort werden h/j/k/l getippt)
  Ctrl-j = fmDown
  Ctrl-k = fmUp
  Ctrl-h = fmLeft
  Ctrl-l = fmRight
}

mode commander extends fmbase {
  ESC = fmClose
  k = fmUp
  j = fmDown
  h = fmLeft
  l = fmRight
  HOME = fmHome
  END = fmEnd
  BACKSPACE = fmParent
  DELETE = fmDelete
  r = fmRename
  / = fmFind
  Ctrl-f = fmFind
}

# Suchfeld im Dateimanager: links Dateinamen, rechts Treffer im Inhalt
mode fmsearch extends fmbase {
  ESC = fmSearchDone
  BACKSPACE = fmSearchBackspace
  Ctrl-u = fmSearchClear
  ANY = fmSearchChar
}
