# Eingabe in einem Fenster (z. B. Arbeitsordner, Ziel beim Kopieren)
mode popup {
  Ctrl-c DIGIT = bankCopy
  Ctrl-c Ctrl-DIGIT = bankCopy
  Ctrl-c b DIGIT DIGIT = bankTransfer
  Ctrl-v DIGIT = bankPaste
  Ctrl-v Ctrl-DIGIT = bankPaste
  ESC = popupClose
  ENTER = popupRun
  BACKSPACE = popupBackspace
  TAB = popupComplete
  Ctrl-u = popupClear
  Ctrl-v = popupPaste
  ANY = popupChar
}

# Dateimanager (Strg+P): Tasten in beiden Modes wie beim Norton Commander
mode fmbase {
  Ctrl-c DIGIT = bankCopy
  Ctrl-c Ctrl-DIGIT = bankCopy
  Ctrl-c b DIGIT DIGIT = bankTransfer
  Ctrl-v DIGIT = bankPaste
  Ctrl-v Ctrl-DIGIT = bankPaste
  F10 = fmClose
  Ctrl-p = fmClose
  UP = fmUp
  DOWN = fmDown
  PGUP = fmPageUp
  PGDN = fmPageDown
  # TAB: Suchfeld -> linke Spalte -> rechte Spalte -> Suchfeld, Shift+TAB zurueck
  TAB = fmFocus
  Shift-TAB = fmFocus -1
  ENTER = fmEnter
  F1 = fmHelp
  F2 = fmNewFile
  F3 = fmView
  F4 = fmOpen
  F5 = fmCopy
  F6 = fmMove
  F7 = fmMkdir
  F8 = fmDelete
  Ctrl-r = fmRefresh
  Ctrl-w = fmWorkdir
  # Strg+hjkl geht auch im Suchfeld (dort werden h/j/k/l getippt)
  Ctrl-j = fmDown
  Ctrl-k = fmUp
  Ctrl-h = fmLeft
  Ctrl-l = fmRight
}

mode commander extends fmbase {
  ESC = fmClose
  k = fmUp
  j = fmDown
  h = fmLeft
  l = fmRight
  HOME = fmHome
  END = fmEnd
  BACKSPACE = fmParent
  DELETE = fmDelete
  r = fmRename
  / = fmFind
  Ctrl-f = fmFind
}

# Suchfeld im Dateimanager: links Dateinamen, rechts Treffer im Inhalt
mode fmsearch extends fmbase {
  ESC = fmSearchDone
  BACKSPACE = fmSearchBackspace
  Ctrl-u = fmSearchClear
  ANY = fmSearchChar
}
