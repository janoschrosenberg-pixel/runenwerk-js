# editor.config - was RUNENWERK JS beim Start laedt (liegt in ~/.runenjs)
#
#   set NAME WERT     fontSize, font (Liste, die erste vorhandene gilt), indent, tabWidth,
#                     autoComplete on|off (Vorschlaege nach "."), maxFileSize (KiB, Inhaltssuche)
#   lsp BEFEHL        Language Server (zuerst aus node_modules/.bin im Arbeitsordner)
#   ignore ORDNER...  zusaetzlich nicht indizieren (node_modules, .git, dist, build ... sind schon dabei)
#   keymap DATEI      Tastenbelegung
#   mapping ORDNER    Mapping-Funktionen (*.map)
#   compile BEFEHL    F9 im Arbeitsordner (Ausgabe im Terminal)
#   compileFast BEFEHL  F10
#   open DATEI        Datei beim Start oeffnen (relativ zum Arbeitsordner)
set fontSize 15
set font JetBrains Mono, Cascadia Mono, Consolas, SF Mono, Menlo, DejaVu Sans Mono, Liberation Mono, Monospaced
set indent 2
set tabWidth 4
set autoComplete on
set maxFileSize 1024
lsp typescript-language-server --stdio
ignore storybook-static .nuxt
keymap keymap.config
mapping mapping
compile npm run build
compileFast npx tsc --noEmit
