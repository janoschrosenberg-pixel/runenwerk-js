# sondertasten.config - Tasten, die frueher fest im Programm standen
#
# Gleiche Schreibweise wie keymap.config. Fehlt die Datei neben runenjs.jar, legt der Editor sie beim
# Start an. Die Vorgabe aus der Jar gilt immer, diese Datei ergaenzt und ueberschreibt sie.
# Neu laden: keymap (in der Befehlszeile). Uebersicht aller Tasten: bindings

# Gilt in jedem Mode, vor dessen eigenen Tasten: Maus und Tastenuebersetzungen
mode immer {
  # Strg+[ wirkt wie ESC (wie in Vim)
  Ctrl-[ = key ESC
  MAUS-LINKS = mouseClick
  MAUS-RAD-HOCH = mouseWheel -1
  MAUS-RAD-RUNTER = mouseWheel 1
}

# Solange das Hover-Fenster (K) offen ist: jede Taste schliesst es; die hier belegten tun sonst nichts
mode info {
  ESC = infoClose
}
